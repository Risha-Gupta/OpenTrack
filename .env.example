# Database
DB_USERNAME=root
DB_PASSWORD=yourpassword

# GitHub API — get from https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# JWT — use a long random string (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379